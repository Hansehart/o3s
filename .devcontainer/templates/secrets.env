# NAME
#        secrets.env — real API tokens for the o3s credential-injecting proxy
#
# SYNOPSIS
#        NAME=token
#
# DESCRIPTION
#        One NAME=token per line. NAME must match a `secret = "NAME"` entry in config.toml.
#        The proxy swaps the o3s marker for the matching token on egress, keyed on the
#        destination host. Rotating a token takes effect on the next request, no restart.
#
#        Out-of-repo and mitmproxy-only: initialize.sh seeds this to ~/.config/o3s/secrets.env;
#        it is never mounted into the cage, so the real tokens never reach it.
#
# EXAMPLES
#        OPENAI_API_KEY=sk-proj-...
#        ANTHROPIC_API_KEY=sk-ant-...
#
# SEE ALSO
#        config.toml — its `secret = "NAME"` entries reference these names.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
