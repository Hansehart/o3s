# NAME
#        .env — o3s cage environment (resource limits and injection marker for secrets)
#
# SYNOPSIS
#        KEY=value
#
# DESCRIPTION
#        Non-secret cage configuration, read by docker compose and loaded into the dev
#        container. Holds no real API keys.
#
#        MEMORY_LIMIT   Cage memory cap (e.g. 8G).
#        CPU_LIMIT      Cage CPU cap (e.g. 4).
#        O3S_MARKER     The marker the proxy swaps for real keys on egress.
#                       Real keys live in ~/.config/o3s/secrets.env, never here.
#
# NOTES
#        Add one var per provider, set to ${O3S_MARKER}.

MEMORY_LIMIT=8G
CPU_LIMIT=4

O3S_MARKER=__O3S_MARKER__
ANTHROPIC_API_KEY=${O3S_MARKER}
MISTRAL_API_KEY=${O3S_MARKER}
OPENAI_API_KEY=${O3S_MARKER}
