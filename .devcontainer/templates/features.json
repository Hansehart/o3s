// NAME
//        features.json — the feature sources the o3s sidebar builds its catalog from
//
// DESCRIPTION
//        Two lists, and nothing else. `collections` names the OCI namespaces to read;
//        each publishes a devcontainer-collection.json holding every feature's name,
//        description, version and option schema, so none of that is repeated here and
//        none of it can drift. `overrides` carries the option values o3s wants that the
//        feature does not already default to — a value equal to the feature's own
//        default is left out, and inherited instead.
//
//        Overrides are keyed by the ref without a version, because the same feature id
//        is published by more than one collection. The version tag a generated
//        devcontainer.json carries is the published major, never a number stated here.
//
// SEE ALSO
//        devcontainer.json
{
    "collections": [
        "ghcr.io/hansehart/devcontainer-features",
        "ghcr.io/devcontainers/features"
    ],
    "overrides": {
        // The cage keeps feature state on the `features` volume, so it survives a rebuild.
        "ghcr.io/hansehart/devcontainer-features/claude-code": {
            "settingsJson": "{\\\"env\\\":{\\\"IS_DEMO\\\":\\\"1\\\"},\\\"attribution\\\":{\\\"commit\\\":\\\"\\\",\\\"pr\\\":\\\"\\\"}}",
            "stateDir": "/home/ubuntu/features/claude"
        },
        "ghcr.io/hansehart/devcontainer-features/codex": {
            "stateDir": "/home/ubuntu/features/codex"
        },
        // The inner daemon does not inherit the cage's resolver, so it is pointed at the
        // gateway by hand. The dev overlay moves the gateway to 10.11.0.2.
        "ghcr.io/hansehart/devcontainer-features/docker-in-docker": {
            "daemonJson": "{\\\"dns\\\":[\\\"10.10.0.2\\\"]}"
        },
        "ghcr.io/hansehart/devcontainer-features/latex": {
            "stateDir": "/home/ubuntu/features/latex"
        },
        "ghcr.io/hansehart/devcontainer-features/node": {
            "stateDir": "/home/ubuntu/features/node"
        },
        "ghcr.io/hansehart/devcontainer-features/sops": {
            "stateDir": "/home/ubuntu/features/sops"
        },
        "ghcr.io/hansehart/devcontainer-features/uv": {
            "python": "3.13",
            "stateDir": "/home/ubuntu/features/uv"
        }
    }
}
