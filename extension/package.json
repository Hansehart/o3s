{
  "name": "o3s",
  "displayName": "o3s",
  "description": "VS Code tooling for the o3s dev sandbox.",
  "version": "0.0.1",
  "publisher": "hansehart",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.o3s"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-vscode-remote.remote-containers"
  ],
  "contributes": {
    "commands": [
      {
        "command": "o3s.generateDevcontainer",
        "title": "o3s: Generate devcontainer.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "o3s",
          "title": "o3s",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "o3s": [
        {
          "id": "o3s.mainView",
          "name": "o3s",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/escape-html": "^1.0.4",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "escape-html": "^1.0.3",
    "jsonc-parser": "^3.3.1"
  }
}
