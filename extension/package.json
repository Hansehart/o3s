{
  "name": "o3s",
  "displayName": "o3s",
  "description": "A feature store for dev containers, in the sidebar.",
  "version": "0.0.1",
  "publisher": "hansehart",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hansehart/o3s.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "configuration": {
      "title": "o3s",
      "properties": {
        "o3s.featureProviders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ghcr.io/devcontainers/features",
            "ghcr.io/hansehart/devcontainer-features"
          ],
          "markdownDescription": "Feature collections the sidebar browses, each `registry/namespace`. Any collection published to the [dev container features spec](https://containers.dev/implementors/features-distribution/) works. Collections already referenced by your `devcontainer.json` are offered without being listed here."
        }
      }
    },
    "commands": [
      {
        "command": "o3s.generateDevcontainer",
        "title": "Open the Feature Store",
        "category": "o3s"
      },
      {
        "command": "o3s.cloneAndSetup",
        "title": "Clone o3s",
        "category": "o3s"
      },
      {
        "command": "o3s.refreshCatalog",
        "title": "Refresh Feature Catalog",
        "category": "o3s",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "o3s",
          "title": "o3s",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "o3s": [
        {
          "id": "o3s.mainView",
          "name": "o3s",
          "type": "webview",
          "when": "remoteName != 'dev-container'"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "o3s.generateDevcontainer",
          "when": "remoteName != 'dev-container'"
        },
        {
          "command": "o3s.cloneAndSetup",
          "when": "remoteName != 'dev-container'"
        },
        {
          "command": "o3s.refreshCatalog",
          "when": "remoteName != 'dev-container'"
        }
      ],
      "view/title": [
        {
          "command": "o3s.refreshCatalog",
          "group": "navigation",
          "when": "view == o3s.mainView"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check:media": "tsc -p tsconfig.media.json",
    "lint": "eslint && npm run check:media",
    "pretest": "npm run compile && npm run check:media",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "escape-html": "^1.0.3",
    "jsonc-parser": "^3.3.1"
  }
}
