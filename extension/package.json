{
  "name": "o3s",
  "displayName": "o3s",
  "description": "VS Code tooling for the o3s dev sandbox.",
  "version": "0.0.1",
  "publisher": "hansehart",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "o3s.generateDevcontainer",
        "title": "o3s: Generate devcontainer.json"
      },
      {
        "command": "o3s.cloneAndSetup",
        "title": "o3s: Clone and Set Up"
      },
      {
        "command": "o3s.refreshCatalog",
        "title": "o3s: Refresh Feature Catalog",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "o3s",
          "title": "o3s",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "o3s": [
        {
          "id": "o3s.mainView",
          "name": "o3s",
          "type": "webview",
          "when": "remoteName != 'dev-container'"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "o3s.generateDevcontainer",
          "when": "remoteName != 'dev-container'"
        },
        {
          "command": "o3s.cloneAndSetup",
          "when": "remoteName != 'dev-container'"
        },
        {
          "command": "o3s.refreshCatalog",
          "when": "remoteName != 'dev-container'"
        }
      ],
      "view/title": [
        {
          "command": "o3s.refreshCatalog",
          "group": "navigation",
          "when": "view == o3s.mainView"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check:media": "tsc -p tsconfig.media.json",
    "lint": "eslint && npm run check:media",
    "pretest": "npm run compile && npm run check:media",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "escape-html": "^1.0.3",
    "jsonc-parser": "^3.3.1"
  }
}
